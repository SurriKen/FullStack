# ЗАДАНИЕ: Сравните время выполнения синхронного и асинхронного кода
import time           # Для измерения времени выполнения
import asyncio        # Основная библиотека для асинхронности
import requests       # Синхронная библиотека для HTTP запросов
import aiohttp        # Асинхронная библиотека для HTTP запросов

# ========== СИНХРОННЫЙ КОД (медленный) ==========

def sync_fetch_url(url):
    """
    Синхронная функция для получения данных с URL
    url: строка с адресом веб-сайта
    Возвращает: длину текста ответа
    """

    # requests.get() блокирует выполнение до получения ответа
    response = requests.get(url)

    # Возвращаем длину текста (для простоты измерения)
    return len(response.text)

def sync_main():
    """
    Синхронная главная функция - выполняет запросы по очереди
    """

    # Засекаем время начала выполнения
    start_time = time.time()

    # Список URL для тестирования
    urls = [
        'https://httpbin.org/delay/1',  # Задержка 1 сек
        'https://httpbin.org/delay/1',  # Задержка 1 сек
        'https://httpbin.org/delay/1'   # Задержка 1 сек
    ]

    # Выполняем запросы ПОСЛЕДОВАТЕЛЬНО (один за другим)
    results = []
    for url in urls:

        print(f"Синхронно: начинаю запрос к {url}")

        # Ждем завершения запроса (БЛОКИРУЕМСЯ на ~1 секунду)
        result = sync_fetch_url(url)
        results.append(result)

        print(f"Синхронно: завершил запрос, получено байт: {result}")

    # Подсчитываем общее время
    total_time = time.time() - start_time
    print(f"🐌 СИНХРОННО: Общее время = {total_time:.2f} секунд")

    return results

# ========== АСИНХРОННЫЙ КОД (быстрый) ==========

async def async_fetch_url(session, url):
    """
    Асинхронная функция для получения данных с URL
    session: объект aiohttp.ClientSession для HTTP запросов
    url: строка с адресом веб-сайта
    Возвращает: длину текста ответа
    """

    # async with автоматически закроет соединение после использования
    async with session.get(url) as response:

        # await означает "жди результат, но НЕ блокируй другие задачи"
        text = await response.text()

        # Возвращаем длину текста
        return len(text)

async def async_main():
    """
    Асинхронная главная функция - выполняет запросы ОДНОВРЕМЕННО
    """

    # Засекаем время начала выполнения
    start_time = time.time()

    # Список URL для тестирования (те же самые)
    urls = [
        'https://httpbin.org/delay/1',  # Задержка 1 сек
        'https://httpbin.org/delay/1',  # Задержка 1 сек
        'https://httpbin.org/delay/1'   # Задержка 1 сек
    ]

    # Создаем HTTP сессию для всех запросов
    async with aiohttp.ClientSession() as session:

        # Создаем список задач (НЕ выполняем их сразу!)
        tasks = []
        for url in urls:

            print(f"Асинхронно: создаю задачу для {url}")

            # Создаем задачу, но НЕ ждем ее выполнения
            task = async_fetch_url(session, url)
            tasks.append(task)

        # gather() запускает ВСЕ задачи ОДНОВРЕМЕННО и ждет завершения всех
        print("Асинхронно: запускаю ВСЕ задачи одновременно...")
        results = await asyncio.gather(*tasks)

        # Выводим результаты
        for i, result in enumerate(results):
            print(f"Асинхронно: задача {i+1} завершена, получено байт: {result}")

    # Подсчитываем общее время
    total_time = time.time() - start_time
    print(f"🚀 АСИНХРОННО: Общее время = {total_time:.2f} секунд")

    return results

# ========== ТОЧКА ВХОДА В ПРОГРАММУ ==========

if __name__ == "__main__":
    """
    Главная функция для запуска обоих тестов
    """

    print("=" * 50)
    print("🧪 ТЕСТ: Синхронный vs Асинхронный код")
    print("=" * 50)

    # Сначала тестируем синхронный код
    print("\n1️⃣ ТЕСТ СИНХРОННОГО КОДА:")
    sync_results = sync_main()

    print("\n" + "="*30)

    # Затем тестируем асинхронный код
    print("\n2️⃣ ТЕСТ АСИНХРОННОГО КОДА:")
    async_results = asyncio.run(async_main())

    print("\n" + "="*50)
    print("📊 ИТОГИ:")
    print("- Синхронный: ~3 секунды (1+1+1)")
    print("- Асинхронный: ~1 секунда (max(1,1,1))")
    print("✅ Асинхронность в 3 раза быстрее!")
    print("="*50)

# ОЖИДАЕМЫЙ РЕЗУЛЬТАТ:
# Синхронный код: ~3 секунды
# Асинхронный код: ~1 секунда
# Разница в производительности: 3x
